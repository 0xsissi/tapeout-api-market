[Unit]
Description=Tapeout API Market website and BSC test-token faucet
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=tam-market
Group=tam-market
WorkingDirectory=/opt/tam-market/current
EnvironmentFile=/etc/tam/market.env
ExecStart=/usr/bin/node --max-old-space-size=160 scripts/run-marketplace.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tam-market
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
