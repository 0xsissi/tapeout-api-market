[Unit]
Description=Tapeout API Market (TAM) Public Bootstrap and Relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=tam-network
Group=tam-network
WorkingDirectory=/opt/tam-network/current
EnvironmentFile=/etc/tam/bootstrap.env
ExecStart=/opt/tam-network/runtime/node-v22.23.2-linux-x64/bin/node --max-old-space-size=128 scripts/run-bootstrap.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tam
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryHigh=160M
MemoryMax=192M
MemorySwapMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
