PROVIDER_PRIVATE_KEY=0xYOUR_PROVIDER_WALLET
# Embedded cliproxy mode: seller starts a local CLIProxyAPI instance and uses
# your Codex OAuth subscription as the upstream backend.
# EMBED_CLIPROXY=true
# CLIPROXY_SOURCE_DIR=/absolute/path/to/CLIProxyAPI
# CLIPROXY_WORK_DIR=/var/lib/clawmarket/embedded-cliproxy
# CLIPROXY_AUTH_DIR=/var/lib/clawmarket/embedded-cliproxy/auths
# CLIPROXY_PORT=4310
# CLIPROXY_EXPOSE_MODELS=gpt-5.4,gpt-5.4-mini
# CLIPROXY_INPUT_PER_1M=80
# CLIPROXY_OUTPUT_PER_1M=80

UPSTREAM_BASE_URL=https://codex-proxy.example.com
UPSTREAM_API_KEY=YOUR_TOKEN
UPSTREAM_MODEL=gpt-5.4
UPSTREAM_INPUT_PER_1M=80
UPSTREAM_OUTPUT_PER_1M=80
# Legacy proxy mode is still supported:
# PROXY_URL=https://api.example.com/cliproxy
# PROXY_HEADERS_JSON={"Authorization":"Bearer YOUR_TOKEN"}
# MODELS_JSON=[{"model":"gpt-5.4","inputPer1m":80,"outputPer1m":80}]
DAILY_LIMIT_USD=1000
CLAWMARKET_PAYMENT_NETWORK=bsc-testnet
CLAWMARKET_PAYMENT_TOKEN=USDC
ESCROW_POOL_ADDRESS=0x90D30bA5d3e72A029335D2B879786ba912EA6e5F
MINING_REWARDS_ADDRESS=
RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
CHAIN_ID=97
BOOTSTRAP_PEERS=/dns4/bootstrap-a.example.com/tcp/9090/p2p/PEER_ID_A,/dns4/bootstrap-b.example.com/tcp/9090/p2p/PEER_ID_B
BOOTSTRAP_MANIFEST_URLS=https://bootstrap-a.example.com/bootstrap.json,https://bootstrap-b.example.com/bootstrap.json
BOOTSTRAP_CACHE_PATH=/var/lib/clawmarket/bootstrap-cache.json
BOOTSTRAP_PEER_CACHE_PATH=/var/lib/clawmarket/known-public-peers.seller.json
BOOTSTRAP_REFRESH_MS=60000
P2P_LISTEN_HOST=0.0.0.0
P2P_LISTEN_PORT=9090
ANNOUNCE_HOST=seller.example.com
P2P_IDENTITY_PATH=/var/lib/clawmarket/seller.key
ANNOUNCEMENT_OUT=/var/lib/clawmarket/seller-seed.json
SELLER_STATUS_HOST=127.0.0.1
SELLER_STATUS_PORT=8787
