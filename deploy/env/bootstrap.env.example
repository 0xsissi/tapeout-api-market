P2P_LISTEN_HOST=0.0.0.0
P2P_LISTEN_PORT=9090
ANNOUNCE_HOST=bootstrap.example.com
P2P_IDENTITY_PATH=/var/lib/clawmarket/bootstrap.key
BOOTSTRAP_EXTRA_PEERS=/dns4/bootstrap-b.example.com/tcp/9090/p2p/PEER_ID_B
BOOTSTRAP_MANIFEST_OUT=/var/www/clawmarket/bootstrap.json
# Public read-only health and peer manifest (optional; no wallet or admin API).
BOOTSTRAP_STATUS_HOST=127.0.0.1
BOOTSTRAP_STATUS_PORT=9092
BOOTSTRAP_PEER_CACHE_PATH=/var/lib/clawmarket/bootstrap-peers.json
BOOTSTRAP_RECONNECT_MS=30000
RELAY_MAX_RESERVATIONS=32
RELAY_DURATION_LIMIT_MS=600000
RELAY_DATA_LIMIT_BYTES=16777216
