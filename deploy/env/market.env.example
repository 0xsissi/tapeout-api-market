# Read-only market website: bind locally until HTTPS/public origin is configured.
TAM_MARKET_HOST=127.0.0.1
TAM_MARKET_PORT=18400
TAM_MARKET_ORIGIN=http://127.0.0.1:18400
# Only enable behind a local reverse proxy that overwrites X-Forwarded-For.
# TAM_MARKET_TRUST_PROXY=loopback

# Optional public multiaddrs from a seed JSON (only its multiaddrs field is read).
# Saved announcements are never used as current sellers.
TAM_MARKET_SEED_FILE=
TAM_MARKET_SELLER_PEERS=
# JSON array of {id,name,url}; keep actual operator endpoints in a private env file.
TAM_MARKET_BOOTSTRAP_SOURCES=
# Comma-separated seller wallets accepted by this operator's admission service.
TAM_ADMISSION_SELLERS=

# Optional dedicated transfer wallet and ledger OUTSIDE the Git checkout.
# Leave empty for a read-only website without a faucet.
TAM_FAUCET_STATE_DIR=
TAM_FAUCET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
